# Google (default)
GOOGLE_API_KEY=your-key-here
# or
OPENAI_API_KEY=your-key-here
# or
ANTHROPIC_API_KEY=your-key-here

# Model to use for LLM calls.
LLM_MODEL="google_genai:gemini-2.5-flash"

# Langsmith
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=your-key-here

# GitHub
GITHUB_TOKEN=your-token-here

# Vector Store
SQLITE_CHECKPOINT_PATH=data/chatbot_memory.db

# Guardrails
GUARDRAIL_SQLITE_CHECKPOINT_PATH=data/guardrail_memory.db
GUARDRAIL_SHOW_REDACTED_INPUT=true

# Chat Thread ID
CHAT_THREAD_ID=demo-thread-1

# Semantic caching
SEMANTIC_CACHE_ENABLED=true
REDIS_URL=redis://localhost:6379
SEMANTIC_CACHE_THRESHOLD=0.80
SEMANTIC_CACHE_DOMAIN=caching-demo
SEMANTIC_CACHE_TTL=86400
SEMANTIC_CACHE_SKIP_MUTATIONS=true

# Typesafe 
TYPESAFE_API_KEY=your-key-here
